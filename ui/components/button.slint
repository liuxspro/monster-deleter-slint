import { VerticalBox } from "std-widgets.slint";

// 自定义按钮组件
component CustomButton inherits Rectangle {
    // 对外属性
    in property <string> text: "Text";
    in property <length> font-size: 16px;

    callback clicked;

    // 默认样式
    width: txt.width + self.font-size;
    height: 30px;
    background: white; // 默认蓝色
    border-radius: 5px;

    // 内部TouchArea处理交互
    ta := TouchArea {
        // 点击事件透传
        clicked => { root.clicked(); }
        // 鼠标光标变为手型
        mouse-cursor: pointer;
    }

    // 文本显示
    txt := Text {
        text: root.text;
        font-size: root.font-size;
        color: black;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 核心：定义状态
    states [
        // 当鼠标悬停 (ta.has-hover 为 true) 时，背景变为更深的蓝色
        hovered when ta.has-hover: {
            background: #db9ef7; // 悬停颜色
        }
    ]
}

export { CustomButton }
